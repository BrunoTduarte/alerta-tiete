# Copie este arquivo para .env e preencha. O .env NUNCA vai para o GitHub (.gitignore).

# ---------- Banco de dados (MySQL) ----------
# Use o usuário criado no schema.sql (menor privilégio), não o root.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=alerta_app
MYSQL_PASSWORD=troque_este_valor
MYSQL_DATABASE=alerta_tiete

# ---------- Servidor web ----------
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ---------- Token do agente da Defesa Civil (PUT e DELETE) ----------
# Gere um valor forte com:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTE_TOKEN=troque_este_valor

# ---------- Servidor de alertas por socket TCP ----------
SOCKET_HOST=127.0.0.1
SOCKET_PORT=5050
SOCKET_TOKEN=troque_este_valor

# ---------- Limites e integrações ----------
LIMITE_POSTS_POR_MINUTO=5
OPEN_METEO_TIMEOUT=5
LOG_ARQUIVO=logs/app.log
